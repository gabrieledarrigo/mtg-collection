{
  "compilerOptions": {
    "rootDirs": [
      "./src",
      "./tests"
    ],
    "outDir": "./dist",
    "module": "commonjs",
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "node"
    ],
    "sourceMap": true,
    "noEmit": true,
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "moduleResolution": "node",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@components/*": [
        "./src/app/components/*"
      ],
      "@database/*": [
        "./src/database/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@importer/*": [
        "./src/importer/*"
      ],
      "@test/*": [
        "./test/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ],
  "include": [
    "next-env.d.ts",
    "jest-dom.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts"
  ]
}
