{
  "compilerOptions": {
    "rootDirs": ["./src", "./tests"],
    "outDir": "./dist",
    "module": "commonjs",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "paths": {
      "@database/*": ["./src/database/*"],
      "@config/*": ["./src/config/*"],
      "@importer/*": ["./src/importer/*"],
      "@test/*": ["./test/*"]
    }
  },
  "exclude": ["node_modules", "dist", "prisma.config.ts"]
}
