{
  "name": "mtg-collection",
  "version": "0.1.0",
  "description": "Track the collection of my mtg cards",
  "keywords": [
    "mtg",
    "magic",
    "cards"
  ],
  "homepage": "https://github.com/gabrieledarrigo/mtg-collection#readme",
  "bugs": {
    "url": "https://github.com/gabrieledarrigo/mtg-collection/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieledarrigo/mtg-collection.git"
  },
  "license": "MIT",
  "author": {
    "name": "Gabriele D'Arrigo",
    "email": "darrigo.g@gmail.com"
  },
  "engines": {
    "node": ">=24",
    "npm": "^11"
  },
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "prettier . --check",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build",
    "db:seed": "prisma db seed",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "client:generate": "prisma generate",
    "app:build": "next build",
    "app:dev": "next dev",
    "app:start": "next start",
    "test": "jest",
    "import": "tsx src/importer/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@scryfall/api-types": "^1.0.0-alpha.4",
    "dotenv": "^17.3.1",
    "fast-csv": "^5.0.5",
    "next": "^16.1.6",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
